{
  "name": "FlowOps 01 - Client Onboarding",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Client Onboarding",
        "formDescription": "Enter your details and upload the required documents.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full name",
              "fieldName": "full_name",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldName": "email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Company",
              "fieldName": "company",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldLabel": "Government ID",
              "fieldName": "government_id",
              "fieldType": "file",
              "requiredField": true
            },
            {
              "fieldLabel": "Proof of address",
              "fieldName": "proof_of_address",
              "fieldType": "file",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "client-form",
      "name": "Client Onboarding Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/intake",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $('Client Onboarding Form').first().json.email, full_name: $('Client Onboarding Form').first().json.full_name, company: $('Client Onboarding Form').first().json.company || '', source: 'n8n_form' }) }}"
      },
      "id": "create-case",
      "name": "Create Case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [250, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "flowops-secret",
          "name": "FlowOps API Secret"
        }
      },
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "jsCode": "const form = $('Client Onboarding Form').first();\nconst caseId = $('Create Case').first().json.case_id;\nif (!caseId) throw new Error('Create Case did not return case_id.');\nconst mapping = [\n  { key: 'government_id', doc_type: 'government_id' },\n  { key: 'proof_of_address', doc_type: 'proof_of_address' }\n];\nreturn mapping.map(d => {\n  const file = form.binary?.[d.key];\n  if (!file) throw new Error(`Missing uploaded file binary: ${d.key}. Inspect form trigger output and update the mapping.`);\n  return { json: { case_id: caseId, doc_type: d.doc_type }, binary: { file } };\n});"
      },
      "id": "prepare-documents",
      "name": "Prepare Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8000/cases/{{ $json.case_id }}/documents",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            },
            {
              "name": "doc_type",
              "value": "={{ $json.doc_type }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "upload-documents",
      "name": "Upload And Verify Documents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "flowops-secret",
          "name": "FlowOps API Secret"
        }
      },
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all().map(i => i.json);\nconst caseId = $('Create Case').first().json.case_id;\nconst valid = results.length === 2 && results.every(r => r.status === 'validated');\nreturn [{ json: { case_id: caseId, documents_validated: valid, results } }];"
      },
      "id": "check-documents",
      "name": "Check Document Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.documents_validated }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "documents-valid",
      "name": "Documents Validated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1250, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8000/cases/{{ $json.case_id }}/signature",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "send-engagement-letter",
      "name": "Generate Letter And Send Signing Invitation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, -100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "flowops-secret",
          "name": "FlowOps API Secret"
        }
      },
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { case_id: $('Check Document Results').first().json.case_id, status: 'awaiting_human_review', message: 'Document verification did not pass. Human review or corrected documents are required. No signing invitation was initiated.' } }];"
      },
      "id": "human-document-review",
      "name": "Stop For Human Document Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 120]
    }
  ],
  "connections": {
    "Client Onboarding Form": {
      "main": [[{ "node": "Create Case", "type": "main", "index": 0 }]]
    },
    "Create Case": {
      "main": [[{ "node": "Prepare Documents", "type": "main", "index": 0 }]]
    },
    "Prepare Documents": {
      "main": [[{ "node": "Upload And Verify Documents", "type": "main", "index": 0 }]]
    },
    "Upload And Verify Documents": {
      "main": [[{ "node": "Check Document Results", "type": "main", "index": 0 }]]
    },
    "Check Document Results": {
      "main": [[{ "node": "Documents Validated?", "type": "main", "index": 0 }]]
    },
    "Documents Validated?": {
      "main": [
        [{ "node": "Generate Letter And Send Signing Invitation", "type": "main", "index": 0 }],
        [{ "node": "Stop For Human Document Review", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}