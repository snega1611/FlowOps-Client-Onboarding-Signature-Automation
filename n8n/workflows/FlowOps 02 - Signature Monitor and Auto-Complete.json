
{
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "flowops-schedule-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-CLOUDFLARE-URL/reconcile/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-FlowOps-Secret",
              "value": "YOUR_FLOWOPS_SECRET"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "flowops-reconcile-request",
      "name": "Reconcile FlowOps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Reconcile FlowOps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
